<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve images if requested at /images/...
  RewriteCond %{REQUEST_URI} ^/images/(.*)$
  RewriteCond %{DOCUMENT_ROOT}/images/%1 -f
  RewriteRule ^images/(.*)$ images/$1 [L]

  RewriteCond %{REQUEST_URI} ^/images/(.*)$
  RewriteCond %{DOCUMENT_ROOT}/public/images/%1 -f
  RewriteRule ^images/(.*)$ public/images/$1 [L]

  RewriteCond %{REQUEST_URI} ^/images/(.*)$
  RewriteCond %{DOCUMENT_ROOT}/dist/images/%1 -f
  RewriteRule ^images/(.*)$ dist/images/$1 [L]

  RewriteCond %{REQUEST_URI} ^/src/assets/images/(.*)$
  RewriteCond %{DOCUMENT_ROOT}/public/images/%1 -f
  RewriteRule ^src/assets/images/(.*)$ public/images/$1 [L]

  # If dist directory is deployed
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^$ dist/index.html [L]

  # Pass sitemap.xml and robots.txt through directly
  RewriteCond %{REQUEST_URI} ^/(sitemap\.xml|robots\.txt|ads\.txt|app-ads\.txt|google[a-z0-9]+\.html)$
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ public/$1 [L]

  RewriteCond %{REQUEST_URI} ^/(sitemap\.xml|robots\.txt|ads\.txt|app-ads\.txt|google[a-z0-9]+\.html)$
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA Fallback: check dist first, then root
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule . /dist/index.html [L]

  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
